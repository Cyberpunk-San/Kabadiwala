# ==============================================================================
# Mai Hu Kabadiwala — backend settings (copy to .env next to this file)
# Everything is optional: with no keys the app still works using offline AI.
# Real environment variables override this file.
# ==============================================================================

# ─── Free AI keys ───────────────────────────────────────────────────────────
# Hugging Face: https://huggingface.co/settings/tokens → "Create new token" → type "Read".
# Powers photo → material detection AND the Kabadi Sahayak chat assistant.
HF_API_TOKEN=

# Optional second chat provider (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Advanced (defaults are fine) ───────────────────────────────────────────
# HF_VISION_MODEL=openai/clip-vit-large-patch14
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# GEMINI_MODEL=gemini-2.0-flash
# VISION_BACKEND=auto        # auto | hf | local | off
# ENABLE_LOCAL_CLIP=true     # set false to never download the 600 MB local model
# AI_TIMEOUT_S=30
# MHK_DB_PATH=data/mhk.db    # SQLite file (created and seeded on first run)
# MHK_ALLOWED_ORIGINS=*      # comma-separated CORS origins; * is fine for local dev
