{
  "expo": {
    "name": "Mai Hu Kabadiwala",
    "slug": "mai-hu-kabadiwala",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "maihukabadiwala",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.maihukabadiwala.collector",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4D3A"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mai Hu Kabadiwala to photograph e-waste for material identification."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Mai Hu Kabadiwala to estimate pickup distance and nearby buyer options."
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-asset",
      "expo-speech-recognition",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
