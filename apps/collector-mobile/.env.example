# ==============================================================================
# Mai Hu Kabadiwala - Collector Mobile App Environment Variables
# In Expo, any variable exposed to the client MUST start with EXPO_PUBLIC_
# ==============================================================================

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Core Backend REST API Base URL
# - Local Android Emulator: http://10.0.2.2:8000/api
# - Local iOS Simulator / Web: http://localhost:8000/api
# - Local Physical Device: http://<YOUR_LOCAL_IP>:8000/api
# - Staging / Production: https://api.maihukabadiwala.org/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# AI Vision Inference Service
EXPO_PUBLIC_AI_VISION_API_URL=http://localhost:8000/api/v1/vision/analyze
EXPO_PUBLIC_AI_VISION_API_KEY=mhk_vision_dev_key_sample_123

# Maps & Geolocation API (Google Maps / MapLibre / OpenStreetMap)
EXPO_PUBLIC_MAPS_API_KEY=AIzaSyDevSampleGoogleMapsKey123456789
EXPO_PUBLIC_DEFAULT_LATITUDE=18.5204
EXPO_PUBLIC_DEFAULT_LONGITUDE=73.8567
EXPO_PUBLIC_DEFAULT_CITY=Pune

# Internationalization & Voice Settings
# Supported locales: 'en' | 'hi' | 'mr'
EXPO_PUBLIC_DEFAULT_LOCALE=hi
EXPO_PUBLIC_TTS_SPEECH_RATE=0.9
EXPO_PUBLIC_CURRENCY_SYMBOL=₹

# Offline & Sync Engine Settings
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000
EXPO_PUBLIC_MAX_OFFLINE_LOTS=500

# Mock Mode (When true, falls back to demo data if backend is unreachable)
EXPO_PUBLIC_USE_MOCK_FALLBACKS=true

# Payment Gateway (UPI / Razorpay / Cashfree test keys)
EXPO_PUBLIC_PAYMENT_GATEWAY_KEY=rzp_test_sampleKey98765

# Telecom USSD / SMS Gateway (for basic phone fallbacks)
EXPO_PUBLIC_SMS_GATEWAY_URL=https://sms-gateway.maihukabadiwala.org/v1/dispatch

# Telemetry & Monitoring (Sentry DSN)
EXPO_PUBLIC_SENTRY_DSN=https://samplekey@o0.ingest.sentry.io/0
# Recycler portal opened from the role selector
EXPO_PUBLIC_RECYCLER_WEB_URL=http://localhost:3000
