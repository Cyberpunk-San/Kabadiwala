# ==============================================================================
# Mai Hu Kabadiwala — collector app settings (copy to .env next to this file)
#
# Everything here is bundled into the app and readable by anyone, so it holds
# NO keys or secrets. AI keys belong in apps/backend/.env.
# Restart `npx expo start --clear` after changing this file.
# ==============================================================================

# Backend API (must end in /api).
#   Web, iOS simulator ........ http://localhost:8000/api
#   Android emulator .......... localhost is rewritten to 10.0.2.2 automatically
#   Phone with Expo Go ........ localhost is rewritten to your PC's Wi-Fi IP automatically.
#                               If your PC has several network adapters (VirtualBox, VPN),
#                               start Expo with REACT_NATIVE_PACKAGER_HOSTNAME=<PC Wi-Fi IP>
#                               or set http://<PC Wi-Fi IP>:8000/api here.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Map centre used before the collector shares their location (Pune).
EXPO_PUBLIC_DEFAULT_LATITUDE=18.5204
EXPO_PUBLIC_DEFAULT_LONGITUDE=73.8567

# First-launch language: hi | mr | en
EXPO_PUBLIC_DEFAULT_LOCALE=hi

# Read-aloud speed (0.1–2.0)
EXPO_PUBLIC_TTS_SPEECH_RATE=0.9

# How often queued offline lots are synced, in ms (min 5000)
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000
